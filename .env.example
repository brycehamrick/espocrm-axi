# EspoCRM site hostname or URL (required). Bare hostnames get https:// prepended.
export ESPO_CRM_DOMAIN="crm.example.com"

# Which credential this is (auto | api-key | basic | hmac). `auto` = basic when a
# username is set, otherwise api-key. Set it explicitly so the intent is clear.
export ESPO_CRM_AUTH_MODE="basic"

# --- Live user credential (basic) -------------------------------------------------
# The only mode that can read a user's inbox/team folders, send from a user's
# addresses, and see per-user read/archive state. The token is bootstrapped from
# the password whenever it is missing or expired (48h idle); nothing is stored
# unless you run `espocrm-axi auth refresh --write-env`.
export ESPO_CRM_AUTH_USER="you"
export ESPO_CRM_AUTH_PASSWORD="..."

# Optional: a current auth token. Saves one bootstrap request per run.
# export ESPO_CRM_API_KEY="<token>"

# --- API User (api-key) ------------------------------------------------------------
# export ESPO_CRM_API_KEY="<32-char key from Administration > API Users>"

# --- Optional overrides ------------------------------------------------------------
# export ESPO_CRM_SECRET_KEY="..."     # hmac mode only
# export ESPO_CRM_WHERE_STYLE="auto"   # auto | where | whereGroup (WAF workaround)
# export ESPO_CRM_TIMEOUT_MS="60000"
