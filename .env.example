# EspoCRM site hostname or URL (required). Bare hostnames get https:// prepended.
export ESPO_CRM_DOMAIN="crm.example.com"

# Credential (required). What it is depends on the auth mode:
#   api-key (default when no username is set): an API User key, sent as X-Api-Key.
#   basic    (default when ESPO_CRM_USERNAME is set): a user auth token, sent as
#            Authorization: Basic base64(<username>:<token>).
export ESPO_CRM_API_KEY="..."

# Username for user-token (basic) auth. Set this when the key is a regular-user
# auth token rather than an API User key. Needed for per-user inbox access.
# export ESPO_CRM_USERNAME=""

# Optional: password used to bootstrap a fresh user token when the stored one
# expires (48h idle by default). Never printed or written anywhere unless you
# run `espocrm-axi auth refresh --write-env`.
# export ESPO_CRM_PASSWORD=""

# Optional overrides
# export ESPO_CRM_AUTH_MODE="auto"        # auto | api-key | basic
# export ESPO_CRM_WHERE_STYLE="auto"      # auto | where | whereGroup (WAF workaround)
# export ESPO_CRM_TIMEOUT_MS="60000"
